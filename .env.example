# Database
DATABASE_URL=mysql://user:password@localhost:3306/rivers_lodge

# Admin seed (used by scripts/seed-admin.ts)
ADMIN_EMAIL=admin@example.com
ADMIN_TEMP_PASSWORD=ChangeMe123!

# Application
NODE_ENV=development

# Optional: set to "true" to mark the rl_session cookie as cross-site (SameSite=None)
COOKIE_CROSS_SITE=false

# S3 / file storage (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# Internal Forge API (optional)
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Application base URL (used to build invite links)
APP_BASE_URL=http://localhost:5173

# Email / SMTP (optional — if not set, invite links are logged to console only)
# Install nodemailer first: pnpm add nodemailer @types/nodemailer
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=yourpassword
# SMTP_FROM=noreply@riverslodge.com
