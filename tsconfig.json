{
  "include": ["client/src/**/*", "features/**/*", "shared/**/*", "server/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@core/*": ["./_core/*"],
      "@shared/errors": ["./features/_core/shared/errors"],
      "@shared/constants": ["./features/_shared/constants"],
      "@shared/lib/*": ["./features/_shared/lib/*"],
      "@shared/hooks/*": ["./features/_shared/hooks/*"],
      "@shared/components/*": ["./features/_shared/components/*"],
      "@shared/ui/*": ["./features/_shared/ui/*"],
      "@shared/*": ["./features/_shared/*"],
      "@features/*": ["./features/*"],
      "@/_core/*": ["./features/_core/client/*"],
      "@/_shared/*": ["./features/_shared/*"],
      "@/components/ui": ["./features/_shared/ui"],
      "@/components/ui/*": ["./features/_shared/ui/*"],
      "@/components/*": ["./features/_shared/components/*"],
      "@/components": ["./features/_shared/components"],
      "@/hooks/*": ["./features/_shared/hooks/*"],
      "@/hooks": ["./features/_shared/hooks"],
      "@/lib/*": ["./features/_core/client/lib/*"],
      "@/lib": ["./features/_core/client/lib"],
      "@/const": ["./features/_core/client/const"],
      "@/const/*": ["./features/_core/client/const/*"],
      "@/contexts/*": ["./features/_core/client/contexts/*"],
      "@/*": ["./client/src/*"]
    }
  }
}
